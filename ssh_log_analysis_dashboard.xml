<dashboard version="1.1" theme="dark">
  <label>SSH Log Analysis using Splunk</label>
  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="t">
      <label>Time Range</label>
      <default>
        <earliest>0</earliest>
        <latest></latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <html>
        <style>
          .ssh-banner { background: linear-gradient(120deg, #0f2027, #203a43, #2c5364); border-radius: 12px; padding: 22px 28px; color: #fff; }
          .ssh-banner h1 { margin: 0 0 4px 0; font-size: 30px; letter-spacing: 0.5px; }
          .ssh-banner p { margin: 0 0 16px 0; color: #9fb7c4; font-size: 14px; }
          .ssh-kpis { display: flex; flex-wrap: wrap; gap: 14px; }
          .ssh-kpi { flex: 1; min-width: 150px; background: rgba(255,255,255,0.07); border-radius: 10px; padding: 12px 16px; border-left: 5px solid #4DA3FF; }
          .ssh-kpi b { display: block; font-size: 26px; }
          .ssh-kpi span { font-size: 12px; color: #b8c8d2; text-transform: uppercase; letter-spacing: 1px; }
          .k-blue { border-left-color: #4DA3FF; }
          .k-red { border-left-color: #FF5C5C; }
          .k-amber { border-left-color: #FFB020; }
          .k-green { border-left-color: #2ECC71; }
          .k-purple { border-left-color: #B07CFF; }
        </style>
        <div class="ssh-banner">
          <h1>SSH Log Analysis using Splunk</h1>
          <p>SOC analyst view: brute force, failed and successful logins, unauthenticated connections</p>
          <div class="ssh-kpis">
            <div class="ssh-kpi k-blue"><b>1,200</b><span>Total events</span></div>
            <div class="ssh-kpi k-red"><b>305</b><span>Failed logins</span></div>
            <div class="ssh-kpi k-amber"><b>303</b><span>Multiple failures</span></div>
            <div class="ssh-kpi k-green"><b>306</b><span>Successful logins</span></div>
            <div class="ssh-kpi k-purple"><b>286</b><span>No-auth connections</span></div>
          </div>
        </div>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <title>Task 1: Events by Type</title>
      <chart>
        <search>
          <query>source="ssh_logs.json" | stats count by event_type | sort - count</query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.chart.showPercent">true</option>
        <option name="charting.legend.placement">right</option>
        <option name="charting.seriesColors">[0x4DA3FF,0xFF5C5C,0xFFB020,0x2ECC71]</option>
        <option name="charting.drilldown">none</option>
        <option name="height">360</option>
      </chart>
    </panel>
    <panel>
      <title>Task 2: Top 10 Source IPs - Failed SSH Logins</title>
      <chart>
        <search>
          <query>source="ssh_logs.json" event_type="Failed SSH Login" | stats count as failed_logins by id.orig_h | sort - failed_logins | head 10</query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.seriesColors">[0xFF5C5C]</option>
        <option name="charting.axisTitleX.text">Source IP</option>
        <option name="charting.axisTitleY.text">Failed Logins</option>
        <option name="charting.chart.showDataLabels">all</option>
        <option name="charting.chart.columnSpacing">0.3</option>
        <option name="charting.drilldown">none</option>
        <option name="height">360</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Task 3: Brute Force - IPs with more than 5 Multiple-Failure Events</title>
      <chart>
        <search>
          <query>source="ssh_logs.json" event_type="Multiple Failed Authentication Attempts" | stats count as events, sum(auth_attempts) as total_attempts by id.orig_h | where events > 5 | sort - total_attempts | head 10</query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.legend.placement">top</option>
        <option name="charting.seriesColors">[0xFFB020,0xFF5C5C]</option>
        <option name="charting.axisTitleX.text">Source IP</option>
        <option name="charting.axisTitleY.text">Count</option>
        <option name="charting.chart.showDataLabels">all</option>
        <option name="charting.chart.columnSpacing">0.3</option>
        <option name="charting.drilldown">none</option>
        <option name="height">360</option>
      </chart>
    </panel>
    <panel>
      <title>Task 4: Top 10 Source IPs - Successful SSH Logins</title>
      <chart>
        <search>
          <query>source="ssh_logs.json" event_type="Successful SSH Login" | stats count as successful_logins by id.orig_h | sort - successful_logins | head 10</query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.seriesColors">[0x2ECC71]</option>
        <option name="charting.axisTitleX.text">Source IP</option>
        <option name="charting.axisTitleY.text">Successful Logins</option>
        <option name="charting.chart.showDataLabels">all</option>
        <option name="charting.chart.columnSpacing">0.3</option>
        <option name="charting.drilldown">none</option>
        <option name="height">360</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Task 5: Connections Without Authentication - Top 10 IPs (possible scanning / probing)</title>
      <chart>
        <search>
          <query>source="ssh_logs.json" event_type="Connection Without Authentication" | stats count as unauth_connections by id.orig_h | sort - unauth_connections | head 10</query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.seriesColors">[0xB07CFF]</option>
        <option name="charting.axisTitleX.text">Source IP</option>
        <option name="charting.axisTitleY.text">Unauthenticated Connections</option>
        <option name="charting.chart.showDataLabels">all</option>
        <option name="charting.chart.columnSpacing">0.3</option>
        <option name="charting.drilldown">none</option>
        <option name="height">380</option>
      </chart>
    </panel>
  </row>
</dashboard>
